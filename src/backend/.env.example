# Copy to .env and fill in. Never commit the real .env.
#
# The app runs with none of this set. Charts always render locally, and content
# generation falls back to topic-varied template prose. See "Offline mode" in CLAUDE.md.

# --- Option 1: GitHub Models (hosted, needs a token) ---
# Create a token at https://github.com/settings/tokens (no scopes needed).
GITHUB_TOKEN=
LLM_BASE_URL=https://models.inference.ai.azure.com
LLM_MODEL=gpt-4o-mini

# --- Option 2: a local model, no token required ---
# Any OpenAI-compatible server works. Setting LLM_BASE_URL away from the default is
# enough to enable the LLM path; no key is needed.
#
#   Ollama:     ollama serve && ollama pull llama3.1
#               LLM_BASE_URL=http://localhost:11434/v1
#               LLM_MODEL=llama3.1
#
#   LM Studio:  start the local server from the app
#               LLM_BASE_URL=http://localhost:1234/v1
#               LLM_MODEL=<whatever you loaded>
#
# Generation asks for a strict JSON schema. Ollama 0.5+ and current LM Studio support
# this; on an older build the call fails and generation drops back to template prose.

# --- Option 3: any other OpenAI-compatible provider ---
# LLM_API_KEY is used in preference to GITHUB_TOKEN when both are set.
# LLM_API_KEY=

MIN_TURNS=3
MAX_TURNS=5
CORS_ORIGINS=http://localhost:5173
