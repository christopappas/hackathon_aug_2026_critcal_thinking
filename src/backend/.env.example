# Copy to .env and fill in. Never commit the real .env.
# Create a token at https://github.com/settings/tokens (no scopes needed for GitHub Models).
GITHUB_TOKEN=

# GitHub Models endpoint. Swap these two lines for Azure OpenAI or OpenAI if you hit rate limits.
LLM_BASE_URL=https://models.inference.ai.azure.com
LLM_MODEL=gpt-4o-mini

MIN_TURNS=3
MAX_TURNS=5
CORS_ORIGINS=http://localhost:5173
